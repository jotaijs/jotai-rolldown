{
  "name": "jotai-rolldown",
  "version": "0.2.0",
  "description": "Rolldown plugin for Jotai debug labels and React Refresh support",
  "keywords": [
    "jotai",
    "plugin",
    "rolldown",
    "rolldown-plugin"
  ],
  "homepage": "https://github.com/jotaijs/jotai-rolldown#readme",
  "bugs": {
    "url": "https://github.com/jotaijs/jotai-rolldown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jotaijs/jotai-rolldown.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": "./dist/index.mjs",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "test": "vitest",
    "test:e2e": "pnpm run --filter ./example test",
    "dev": "tsdown --watch",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "oxc-unshadowed-visitor": "^0.1.0",
    "rolldown-string": "^0.3.0"
  },
  "devDependencies": {
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "playwright-chromium": "^1.52.0",
    "rolldown": "^1.0.3",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "rolldown": "^1.0.3",
    "vite": "^8.0.14"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0 || ^24.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "compatiblePackages": {
    "schemaVersion": 1,
    "rollup": {
      "type": "incompatible",
      "reason": "Uses Rolldown-specific APIs"
    }
  }
}
